[Unit]
Description=BTC TargetPulse
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/waseem/repo/trading/predict/cpmc1
ExecStart=/home/waseem/repo/trading/predict/cpmc1/.venv/bin/python -u /home/waseem/repo/trading/predict/cpmc1/app.py --headless --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
